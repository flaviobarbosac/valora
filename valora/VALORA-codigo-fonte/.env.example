# Copie este arquivo para .env e preencha os valores. Nunca publique o .env.

# Banco de dados MySQL/MariaDB (crie o banco vazio antes de rodar as migrações).
DATABASE_URL=mysql://usuario:senha@localhost:3306/valora

# Porta do servidor.
PORT=3000

# Chave usada para assinar as sessões de login. Use um texto aleatório com
# 32 caracteres ou mais e não reutilize em outros sistemas. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esta chave desconecta todos os usuários.
JWT_SECRET=troque-por-um-texto-aleatorio-com-32-caracteres-ou-mais

# Duração da sessão em horas (padrão: 12).
SESSION_HOURS=12

# Cookies seguros (HTTPS). Deixe vazio para detectar automaticamente pelo
# protocolo da requisição; use "true" para forçar em produção atrás de HTTPS.
COOKIE_SECURE=

# Endereço público do app, usado nos links de convite (sem barra no final).
APP_URL=http://localhost:3000

# E-mail dos convites (SMTP). Sem SMTP_HOST, o app mostra o link para copiar.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e uma "senha de app" em SMTP_PASS.
# Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
# "true" para a porta 465 (SSL direto); deixe "false" para 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente, ex.: "VALORA <convites@suaempresa.com.br>". Se vazio, usa SMTP_USER.
SMTP_FROM=